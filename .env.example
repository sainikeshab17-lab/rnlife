
# RIGHTNOWLIFE — Supabase PostgreSQL

# Set these in .env.local using the connection strings shown in Supabase.
# DATABASE_URL: server runtime connection (prefer the Supabase pooler URI).
# DIRECT_URL: direct PostgreSQL connection used only by schema migration/import scripts.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"
PG_POOL_MAX="10"

# Supabase authentication — configure values from the Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Razorpay TEST MODE — replace with real test credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Transactional email — configure a Resend API key and verified sender before launch
RESEND_API_KEY="re_replace_with_your_key"
EMAIL_FROM="orders@rightnowlife.in"
ADMIN_NOTIFICATION_EMAIL=""
SELLER_NOTIFICATION_EMAIL=""

# Shiprocket — disabled until explicitly enabled; never use NEXT_PUBLIC_ variables
SHIPROCKET_ENABLED="false"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
# Package defaults used when catalog products do not define parcel dimensions (cm/kg)
SHIPROCKET_PACKAGE_WEIGHT_KG=""
SHIPROCKET_PACKAGE_LENGTH_CM=""
SHIPROCKET_PACKAGE_BREADTH_CM=""
SHIPROCKET_PACKAGE_HEIGHT_CM=""
# Webhooks remain disabled until Shiprocket's delivery of its optional token is confirmed
SHIPROCKET_WEBHOOK_SECRET=""

# Storefront
NEXT_PUBLIC_BRAND_NAME="RIGHTNOWLIFE"
NEXT_PUBLIC_SUPPORT_EMAIL="rightnowlife8@gmail.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin security — generate a strong random secret
ADMIN_SESSION_SECRET="replace_with_a_random_secret"

# Initial admin setup — use your own credentials
INITIAL_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_ROLE="super_admin"

