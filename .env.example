# RIGHTNOWLIFE ENVIRONMENT CONFIGURATION
# Phase 2: Secure Checkout, Razorpay Payments & Order Management

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode Credentials)
# Get these from: https://dashboard.razorpay.com/#/app/keys
# -----------------------------------------------------------------------------
# Public Key ID (Required for frontend Checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Server-only Key ID and Secret (Never expose to client or commit to git)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Settings -> Webhooks)
# Webhook URL: https://your-domain.com/api/webhooks/razorpay
# Events to enable: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# Database Configuration
# Default: Local SQLite (data/rightnowlife.db) works zero-config locally.
# Production: Set to PostgreSQL connection string.
# -----------------------------------------------------------------------------
DATABASE_URL=file:./data/rightnowlife.db
# DATABASE_URL=postgresql://user:password@localhost:5432/rightnowlife?schema=public

# -----------------------------------------------------------------------------
# Transactional Email Notifications (Optional)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_YOUR_RESEND_KEY
# EMAIL_FROM=orders@rightnowlife.in

# -----------------------------------------------------------------------------
# Storefront Branding Defaults
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=RIGHTNOWLIFE
NEXT_PUBLIC_SUPPORT_EMAIL=care@rightnowlife.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Phase 3: Secure Admin Authentication & Authorization
# -----------------------------------------------------------------------------
# High-entropy secret for hashing admin session tokens (min 32 characters)
ADMIN_SESSION_SECRET=change_this_to_a_long_random_secret_in_production_32chars

# Initial Administrator Provisioning (used by setup command)
INITIAL_ADMIN_EMAIL=admin@rightnowlife.in
INITIAL_ADMIN_PASSWORD=RightNowLife@Admin2026
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_ROLE=super_admin

