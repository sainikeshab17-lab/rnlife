
# RIGHTNOWLIFE — Supabase PostgreSQL

# Set these in .env.local using the connection strings shown in Supabase.
# DATABASE_URL: server runtime connection (prefer the Supabase pooler URI).
# DIRECT_URL: direct PostgreSQL connection used only by schema migration/import scripts.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"
PG_POOL_MAX="10"

# Supabase authentication — configure values from the Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Razorpay TEST MODE — replace with real test credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# WhatsApp Cloud API webhook — set the same verify token in Meta's webhook configuration
WHATSAPP_VERIFY_TOKEN="replace_with_a_long_random_token"
META_APP_SECRET="YOUR_META_APP_SECRET"

# Transactional email — configure a Resend API key and verified sender before launch
RESEND_API_KEY="re_replace_with_your_key"
EMAIL_FROM="orders@rightnowlife.in"
ADMIN_NOTIFICATION_EMAIL=""
SELLER_NOTIFICATION_EMAIL=""

# Twilio WhatsApp order confirmations. Verify the account and approved Content SID in Twilio Console.
# Use the sandbox sender for opted-in test recipients only; set production's approved sender separately.
TWILIO_WHATSAPP_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN="replace_with_your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:"
TWILIO_CONTENT_SID="HX_RETRIEVE_FROM_TWILIO_CONTENT_TEMPLATE_BUILDER"
# JSON mapping from the template's actual numeric placeholder keys to order fields (id, order_number, customer_name, total).
# Use exact approved keys if it has variables. Set the flag only after confirming it has none.
TWILIO_CONTENT_VARIABLES="{}"
TWILIO_TEMPLATE_HAS_NO_VARIABLES="false"

# Shiprocket — disabled until explicitly enabled; never use NEXT_PUBLIC_ variables
SHIPROCKET_ENABLED="false"
SHIPROCKET_SERVICEABILITY_ENABLED="false"
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_PICKUP_POSTCODE=""
# Measured product unit weight used by admin shipment preparation; parcel total = unit weight × saved quantities.
SHIPROCKET_ITEM_WEIGHT_KG=""
# Package defaults used when catalog products do not define parcel dimensions (cm/kg)
SHIPROCKET_PACKAGE_WEIGHT_KG=""
SHIPROCKET_PACKAGE_LENGTH_CM=""
SHIPROCKET_PACKAGE_BREADTH_CM=""
SHIPROCKET_PACKAGE_HEIGHT_CM=""
# Webhooks remain disabled until Shiprocket's delivery of its optional token is confirmed
SHIPROCKET_WEBHOOK_SECRET=""
# Exact comma-separated HTTPS hostnames observed and verified in Shiprocket staging label responses.
SHIPROCKET_LABEL_ALLOWED_HOSTS=""

# Storefront
NEXT_PUBLIC_BRAND_NAME="RIGHTNOWLIFE"
NEXT_PUBLIC_SUPPORT_EMAIL="rightnowlife8@gmail.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin security — generate a strong random secret
ADMIN_SESSION_SECRET="replace_with_a_random_secret"
# Local `npm run dev` uses the loopback-only Next proxy, so leave this blank
# locally. Production must set a custom x-* header that ingress strips from
# incoming requests and overwrites with the actual client IP.
ADMIN_LOGIN_TRUSTED_IP_HEADER=""
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_LOGIN_EMAIL_ATTEMPT_LIMIT=10
ADMIN_LOGIN_IP_ATTEMPT_LIMIT=300

# Initial admin setup — use your own credentials
INITIAL_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_ROLE="super_admin"

