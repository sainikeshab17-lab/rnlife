generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                       String    @id
  orderNumber              String    @unique @map("order_number")
  customerName             String    @map("customer_name")
  customerEmail            String    @map("customer_email")
  customerPhone            String    @map("customer_phone")
  subtotal                 Int
  shipping                 Int
  discount                 Int       @default(0)
  total                    Int
  paymentMethod            String    @map("payment_method")
  paymentStatus            String    @default("pending_payment") @map("payment_status")
  orderStatus              String    @default("pending_payment") @map("order_status")
  razorpayOrderId          String?   @map("razorpay_order_id")
  razorpayPaymentId        String?   @map("razorpay_payment_id")
  razorpaySignature        String?   @map("razorpay_signature")
  guestToken               String    @map("guest_token")
  userId                   String?   @map("user_id")
  courierName              String?   @map("courier_name")
  trackingNumber           String?   @map("tracking_number")
  trackingUrl              String?   @map("tracking_url")
  notes                    String?
  cancelledReason          String?   @map("cancelled_reason")
  refundStatus             String?   @map("refund_status")
  refundId                 String?   @map("refund_id")
  dispatchDate             DateTime? @map("dispatch_date") @db.Timestamptz(6)
  estimatedDeliveryDate    DateTime? @map("estimated_delivery_date") @db.Timestamptz(6)
  actualDeliveryDate       DateTime? @map("actual_delivery_date") @db.Timestamptz(6)
  cancellationRequested   Int?      @default(0) @map("cancellation_requested")
  cancellationRequestedAt DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  cancellationReason      String?   @map("cancellation_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  items          OrderItem[]
  addresses      OrderAddress[]
  statusHistory  OrderStatusHistory[]
  shippingEvents ShippingEvent[]
  returns        ReturnRequest[]
  refunds        RefundRecord[]

  @@index([customerEmail])
  @@index([razorpayOrderId])
  @@index([guestToken])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String @id
  orderId     String @map("order_id")
  productId   String @map("product_id")
  productSlug String @map("product_slug")
  productName String @map("product_name")
  color       String
  size        String
  price       Int
  quantity    Int
  image       String
  sku         String
  fit         String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderAddress {
  id           String @id
  orderId      String @map("order_id")
  fullName     String @map("full_name")
  phone        String
  addressLine1 String @map("address_line1")
  addressLine2 String? @map("address_line2")
  landmark     String?
  city         String
  state        String
  pinCode      String @map("pin_code")
  country      String @default("India")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_addresses")
}

model Inventory {
  productId String @map("product_id")
  size      String
  stock     Int    @default(20)
  reserved  Int    @default(0)

  @@id([productId, size])
  @@index([productId])
  @@map("inventory")
}

model PaymentAudit {
  id        String   @id
  orderId   String?  @map("order_id")
  eventType String   @map("event_type")
  payload   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([eventType])
  @@map("payment_audits")
}

model OrderStatusHistory {
  id         String   @id
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actor      String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@map("order_status_history")
}

model AdminUser {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  isActive     Int      @default(1) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id
  adminId   String   @map("admin_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([adminId])
  @@map("admin_sessions")
}

model InventoryAdjustment {
  id        String   @id
  productId String   @map("product_id")
  size      String
  prevStock Int      @map("prev_stock")
  newStock  Int      @map("new_stock")
  delta     Int
  reason    String
  actor     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId])
  @@index([createdAt(sort: Desc)])
  @@map("inventory_adjustments")
}

model AuditLog {
  id          String   @id
  actor       String
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeValue String?  @map("before_value")
  afterValue  String?  @map("after_value")
  metadata    String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actor])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ProductOverride {
  productId         String   @id @map("product_id")
  isActive          Int      @default(1) @map("is_active")
  customDescription String?  @map("custom_description")
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("product_overrides")
}

model ShippingEvent {
  id            String   @id
  orderId       String   @map("order_id")
  status        String
  location      String?
  description   String
  courierName   String?  @map("courier_name")
  trackingNumber String? @map("tracking_number")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([occurredAt(sort: Desc)])
  @@map("shipping_events")
}

model ReturnRequest {
  id               String   @id
  orderId          String   @map("order_id")
  returnNumber     String   @unique @map("return_number")
  customerEmail    String   @map("customer_email")
  type             String   @default("return")
  status           String   @default("requested")
  reason           String
  customerNote     String?  @map("customer_note")
  adminNote        String?  @map("admin_note")
  customerNotes    String?  @map("customer_notes")
  adminNotes       String?  @map("admin_notes")
  resolutionType   String?  @default("refund") @map("resolution_type")
  refundAmount     Int?     @default(0) @map("refund_amount")
  inspectionResult String?  @map("inspection_result")
  inspectionNotes  String?  @map("inspection_notes")
  restocked        Int      @default(0)
  exchangeItemId   String?  @map("exchange_item_id")
  exchangeSize     String?  @map("exchange_size")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@index([orderId])
  @@index([customerEmail])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id                    String   @id
  returnId              String   @map("return_id")
  orderItemId            String   @map("order_item_id")
  productId              String   @map("product_id")
  productName            String   @map("product_name")
  size                   String
  color                  String
  quantity               Int
  price                  Int
  productSlug            String?  @map("product_slug")
  requestedExchangeSize  String?  @map("requested_exchange_size")
  condition              String?  @default("pending")
  restocked              Int?     @default(0)
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

model RefundRecord {
  id                String   @id
  orderId           String   @map("order_id")
  returnId          String?  @map("return_id")
  razorpayPaymentId String   @map("razorpay_payment_id")
  razorpayRefundId  String?  @map("razorpay_refund_id")
  amount            Int
  amountPaisa       Int      @map("amount_paisa")
  currency          String   @default("INR")
  status            String   @default("requested")
  reason            String?
  idempotencyKey    String   @unique @map("idempotency_key")
  rawResponse       String?  @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  initiatedBy       String?  @map("initiated_by")
  failureReason     String?  @map("failure_reason")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([razorpayRefundId])
  @@map("refund_records")
}

model NotificationJob {
  id                String   @id
  orderId           String?  @map("order_id")
  eventType         String   @map("event_type")
  recipientEmail    String   @map("recipient_email")
  recipientName     String?  @map("recipient_name")
  subject           String
  bodyHtml          String   @map("body_html")
  bodyText          String?  @map("body_text")
  status            String   @default("pending")
  provider          String   @default("none")
  providerMessageId String?  @map("provider_message_id")
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3) @map("max_attempts")
  lastError         String?  @map("last_error")
  idempotencyKey    String   @unique @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([status])
  @@map("notification_jobs")
}
